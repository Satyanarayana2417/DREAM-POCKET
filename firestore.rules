rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is verified (OAuth providers Google/Apple, verified email, or exempted account)
    function isVerifiedUser() {
      return isAuthenticated() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com' ||
        request.auth.token.firebase.sign_in_provider == 'apple.com' ||
        request.auth.token.email == 'siva@gmail.com'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      
      // FCM Tokens subcollection
      match /fcmTokens/{token} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // Notifications history subcollection
      match /notifications/{notificationId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      allow read, update, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && request.resource.data.userId == request.auth.uid;
    }

    // Budgets Collection
    match /budgets/{budgetId} {
      allow read, update, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && request.resource.data.userId == request.auth.uid;
    }

    // Monthly Income Collection
    match /monthlyIncome/{incomeId} {
      allow read, update, delete: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isVerifiedUser() && request.resource.data.userId == request.auth.uid;
    }

    // Families Collection
    match /families/{familyId} {
      allow read, write: if isVerifiedUser();
      
      // Members subcollection
      match /members/{memberId} {
        allow read, write: if isVerifiedUser();
      }
      
      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read, write: if isVerifiedUser();
      }
    }

    // Family Invitations
    match /familyInvitations/{invitationId} {
      allow read, write: if isVerifiedUser();
    }

    // Family Budgets
    match /familyBudgets/{budgetId} {
      allow read, write: if isVerifiedUser();
    }
  }
}
