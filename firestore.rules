rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Expenses Collection
    match /expenses/{expenseId} {
      // Allow read/write only if the authenticated user's ID matches the expense's userId
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Allow create only if the authenticated user's ID matches the provided userId in the new document
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Budgets Collection
    match /budgets/{budgetId} {
      // Budgets follow the exact same rules as expenses
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
